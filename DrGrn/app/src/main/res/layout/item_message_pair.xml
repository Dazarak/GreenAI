<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="9dp"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/MessageUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/light_green"
        android:layout_gravity="end"
        android:gravity="right"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:padding="8dp">

        <ImageView
            android:id="@+id/imageInMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:srcCompat="@android:drawable/ic_menu_gallery" />

        <TextView
            android:id="@+id/UserRequest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_color"
            android:textSize="20dp"
            android:text="Message utilisateur" />
        <ImageButton
            android:id="@+id/imageButtonCopyUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#0000"
            android:layout_weight="1"
            app:srcCompat="?attr/actionModeCopyDrawable" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/MessageIA"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/light_green"
        android:gravity="start"
        android:padding="8dp"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_gravity="start">
        <TextView
            android:id="@+id/AIAnswer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_color"
            android:textSize="20dp"
            android:text="Message de l'IA" />

        <ImageButton
            android:id="@+id/imageButtonCopyIA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#0000"
            android:layout_weight="1"
            app:srcCompat="?attr/actionModeCopyDrawable" />

    </LinearLayout>
</LinearLayout>